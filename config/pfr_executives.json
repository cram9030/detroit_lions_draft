{
  "_comment": "Downloads the front-office / coaching staff history table for every NFL team.",

  "source_name": "pfr_executives",
  "url_template": "https://www.pro-football-reference.com/teams/{team}/executives.htm",

  "iterate": {
    "team": [
      "crd", "atl", "rav", "buf", "car", "chi", "cin", "cle",
      "dal", "den", "det", "gnb", "htx", "clt", "jax", "kan",
      "rai", "sdg", "ram", "mia", "min", "nwe", "nor", "nyg",
      "nyj", "phi", "pit", "sfo", "sea", "tam", "oti", "was"
    ]
  },

  "tables": [
    {
      "id": "executives",
      "output_suffix": "executives"
    }
  ],

  "output_dir": "data/raw/pfr/executives",

  "sleep_between_requests": 4.0,
  "max_retries": 3,
  "retry_backoff": 10.0
}
